# SafeRoute AI configuration. Copy this file to ".env" (same folder as pom.xml) and fill in what you use.
# ".env" is ignored by git, so passwords stay on your computer. Restart the app after changing it.
# Tip: run  powershell -ExecutionPolicy Bypass -File scripts\configure.ps1  to fill this in interactively.

# --- Live tracking links that work on ANY phone or computer -------------------
# Option A (easiest, free, no account): the app opens a Cloudflare quick tunnel by itself.
#   Requires cloudflared:  winget install Cloudflare.cloudflared
#   The public https address changes each time the app starts and is printed in the log.
PUBLIC_TUNNEL=true
# Option B: a fixed public address you already have (ngrok domain, your own server, ...).
# PUBLIC_BASE_URL=https://saferoute.example.com

# --- Email alerts (free with Gmail) ---------------------------------------------
# 1. Turn on 2-Step Verification:  https://myaccount.google.com/security
# 2. Create an App Password:       https://myaccount.google.com/apppasswords  (name it "SafeRoute")
# 3. Paste the 16-character password below (spaces are fine).
# MAIL_USERNAME=your.address@gmail.com
# MAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- SMS alerts (Twilio) ---------------------------------------------------------
# 1. Sign up at https://www.twilio.com/try-twilio (free trial credit).
# 2. Console > Account Info: copy the Account SID and Auth Token.
# 3. Console > Phone Numbers > Buy a number (uses trial credit) and copy it in +E.164 form.
# 4. Trial accounts can only text VERIFIED numbers: Console > Phone Numbers > Verified Caller IDs,
#    add each emergency contact's number there.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567

# --- Push notifications (ntfy) -----------------------------------------------------
# On by default and free; contacts install the "ntfy" app and use the link/QR from "Set up alerts".
# PUSH_ENABLED=true
# NTFY_URL=https://ntfy.sh

# --- Demo data ------------------------------------------------------------------------
# Three synthetic "flagged risk zones" in central Bengaluru, to demonstrate zone warnings in class.
# DEMO_ZONES=true
